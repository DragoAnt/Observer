<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The published version under test: dotnet test -p:PilotVersion=<version>. -->
  <PropertyGroup>
    <PilotVersion Condition="'$(PilotVersion)'==''">1.0.0-beta.1</PilotVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="DragoAnt.Observer.Core" Version="$(PilotVersion)" />
  </ItemGroup>
</Project>
